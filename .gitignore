# ============================================================
# Sinhala/Singlish Phishing Detection — .gitignore
# ============================================================
# Goal: ignore local/build/generated noise; keep submission assets
# (source, docs, datasets, notebooks, configs, CI, tests).
# ============================================================

# -------------------- Android / Gradle --------------------
*.iml
.gradle/
local.properties
/build/
/captures/
.externalNativeBuild/
.cxx/
app/build/
*.apk
*.aab
*.ap_
*.dex

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.mypy_cache/
.ruff_cache/
.pytest_cache/
pytest-cache-files-*/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Virtual environments
venv/
.venv/
env/
ENV/

# -------------------- Node / Frontend --------------------
node_modules/
.npm/
.vite/
.eslintcache
frontend/dist/
frontend/node_modules/


# -------------------- ML artifacts (generated) --------------------
*.model
*.h5
*.hdf5
*.pkl
*.joblib
*.onnx
*.pb
*.pth
*.pt
*.tflite
# Keep Android placeholder model for Milestone 2 structure
!app/src/main/assets/model.tflite

# -------------------- Logs & runtime output --------------------
logs/
*.log

# Experiment / evaluation outputs (keep folder placeholders)
experiments/*
!experiments/.gitkeep
results/*
!results/.gitkeep

# -------------------- Jupyter (keep notebooks, ignore checkpoints) --------------------
.ipynb_checkpoints/

# -------------------- IDE / editor --------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.cursor/

# -------------------- Environment / secrets --------------------
.env
.env.local
.env.production
*.pem
*.key

# -------------------- OS --------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -------------------- Archives (optional local downloads) --------------------
*.zip
*.tar.gz
*.rar

# ============================================================
# Explicitly KEPT for submission (do not add ignore rules for):
#   - dataset/raw/*.csv, dataset/processed/*.csv
#   - notebooks/*.ipynb
#   - ml-engine/, scripts/, tests/, docs/, configs/
#   - app/src/main/assets/ (model.tflite, tokenizer.json, labels.json)
# ============================================================
